# Porta del server
PORT=3000
# Indirizzo su cui ascolta: 0.0.0.0 dietro il proxy di un hosting
HOST=127.0.0.1
# true dietro un reverse proxy (IP e protocollo da X-Forwarded-*)
TRUST_PROXY=false
# URL pubblico dell'app (usato per il redirect OAuth)
APP_URL=http://localhost:3000
# Chiave per firmare i cookie e cifrare i token: almeno 32 caratteri casuali
APP_SECRET=
# External Client App / Connected App di Salesforce
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Versione API Salesforce
SF_API_VERSION=v62.0
# Percorso del database SQLite (usato se DATABASE_URL è vuoto)
DB_PATH=./data/fls-analyzer.db
# Postgres per l'hosting, es. postgres://user:pass@host:5432/orgfox?sslmode=require
DATABASE_URL=
# Nuovi account: invite (serve un invito, npm run account -- invite email) oppure open
SIGNUP=invite
# Org demo in memoria per provare l'app senza Salesforce
DEMO_MODE=false
# Con DEMO_MODE=true: org demo grande (oltre 400 campi, 1500 profili/permission set) per provare la matrice su volumi reali
DEMO_LARGE=false
# true = chi approva deve essere diverso da chi ha preparato il change set
REQUIRE_DIFFERENT_APPROVER=false
